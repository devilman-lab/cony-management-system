# backend/.env.example
#   これを .env にコピーして値を設定してください。.env はコミットされません。

NODE_ENV=development
PORT=3001

# 第1段階で構築したデータベース
DATABASE_URL=postgres://postgres:ここにパスワード@localhost:5432/cony_dev
DB_SCHEMA=cony
DB_POOL_MAX=10
# マネージドDB（Neon 等）を使うときだけ true
DB_SSL=false

# 取込CSVの上限（MB）。通販CSV 95KB、Amazonレポート 480KB。既定 20MB。
MAX_UPLOAD_MB=20

# 添付ファイルの実体を置く場所。データベースには目録だけを持ちます。
ATTACHMENT_DIR=./storage/attachments

# 帳票PDFの日本語フォント。書体は再配布の条件があるため同梱していません。
# 空にすると稼働先にあるもの（メイリオ／MSゴシック／Noto CJK／IPAex）を自動で探します。
# .ttc のように複数書体を含むファイルのときだけ FAMILY も指定します。
PDF_FONT_PATH=
PDF_FONT_FAMILY=

# 32文字以上。本番では必ず作り直してください。
# 生成例: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=開発用の仮の値をここに32文字以上で入れてください
JWT_EXPIRES_SECONDS=28800

# 画面（Next.js）のオリジン。カンマ区切りで複数可。
CORS_ORIGINS=http://localhost:3000
