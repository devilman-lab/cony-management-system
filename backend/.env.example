# backend/.env.example
#   これを .env にコピーして値を設定してください。.env はコミットされません。

NODE_ENV=development
PORT=3001

# 第1段階で構築したデータベース
DATABASE_URL=postgres://postgres:ここにパスワード@localhost:5432/cony_dev
DB_SCHEMA=cony
DB_POOL_MAX=10
# マネージドDB（Neon 等）を使うときだけ true
DB_SSL=false

# 32文字以上。本番では必ず作り直してください。
# 生成例: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=開発用の仮の値をここに32文字以上で入れてください
JWT_EXPIRES_SECONDS=28800

# 画面（Next.js）のオリジン。カンマ区切りで複数可。
CORS_ORIGINS=http://localhost:3000
